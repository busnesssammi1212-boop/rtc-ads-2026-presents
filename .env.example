# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# SECRET: কখনো NEXT_PUBLIC_ দিয়ে শুরু করবেন না
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# AdGem
NEXT_PUBLIC_ADGEM_APP_ID=your_adgem_app_id
# AdGem postback URL-এ বসানোর গোপন key (নিজে লম্বা random string বানান)
ADGEM_POSTBACK_KEY=change-me-long-random-string

# টাকার হিসাব
USER_SHARE=0.30
USD_TO_BDT=120
MIN_WITHDRAW_BDT=200
